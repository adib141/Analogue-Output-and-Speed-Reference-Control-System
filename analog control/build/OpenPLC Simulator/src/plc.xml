              </type>
            </variable>
            <variable name="Analog_Output">
              <type>
                <REAL/>
              </type>
            </variable>
            <variable name="start">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="stop">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="system_run">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="emergency_stop">
              <type>
                <BOOL/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[if stop OR emergency_stop then
    system_run:= false;
elsif start then
    system_run:= true;
end_if
if emergency_stop AND not system_run then
    Analog_Output:= 0.0;
    Speed_Setpoint:= 0.0;
else
    if Speed_Setpoint <=0.0 then
        Analog_Output:= 0.0;
    elsif Speed_Setpoint>= 100.0 then
        Analog_Output:= 10.0;
    else 
        Analog_Output:= (Speed_Setpoint/ 100.0)* 10.0;
    end_if;

end_if]]></xhtml:p>
          </ST>
        </body>
